// Generated by Behique. R1: data-url of li[2]/button[1] after step 2 keeps the previous release's value
// Expected: "https://example.com/posts/first?utm=1&ref=a%20b"
// Actual:   "https%3A%2F%2Fexample.com%2Fposts%2Ffirst%3Futm%3D1%26ref%3Da%2520b"
import { test, expect } from '@playwright/test'

test("data-url of li[2]/button[1] after step 2 keeps the previous release's value", async ({ page, request }) => {
  const dialogs = []
  page.on('dialog', d => { dialogs.push(d.message()); d.accept() })
  // Start from a clean app. This hook is project specific: replace it with your own reset.
  await request.post('/api/reset').catch(() => {})
  await page.goto("/i/")
  await page.locator(".flux .title:has-text(\"First post\")").first().click()
  await page.waitForTimeout(200)
  await page.locator(".flux.current a[href^=\"#dropdown-share\"]").first().click()
  await page.waitForTimeout(200)
  await page.waitForTimeout(250)
  const el = page.locator("xpath=/html/body/div[1]/main[1]/div[5]/article[1]/footer[1]/ul[1]/li[4]/div[1]/ul[1]/li[2]/button[1]").first()
  await expect(el).toBeAttached()
  const attr = await el.getAttribute("data-url")
  expect(attr).not.toBeNull()
  expect(String(attr)).toBe("https://example.com/posts/first?utm=1&ref=a%20b")
})
