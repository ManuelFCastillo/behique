import { test, expect } from '@playwright/test'

test("data-v-f947af81 of div[1]/div[1] after step 0 is still there, as on the previous release", async ({ page, request }) => {
  const dialogs = []
  page.on('dialog', d => { dialogs.push(d.message()); d.accept() })
  // Start from a clean app. This hook is project specific: replace it with your own reset.
  await request.post('/api/reset').catch(() => {})
  // The facts were recorded with every request but GET and HEAD blocked (except during the login step), so the test blocks them too.
  let loginWrites = false
  await page.route('**/*', route => (['GET', 'HEAD'].includes(route.request().method()) || loginWrites ? route.continue() : route.abort()))
  await page.goto("/")
  await page.waitForTimeout(250)
  const el = page.locator("xpath=/html/body/div[1]/div[1]/div[1]").first()
  await expect(el).toBeAttached()
  const attr = await el.getAttribute("data-v-f947af81")
  expect(attr).not.toBeNull()
  expect(String(attr)).toBe("")
})
